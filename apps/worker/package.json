    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20250628.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "vitest": "~4.1.9",
    "wrangler": "^4.22.0"
  }
